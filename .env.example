# Local environment overrides for development. Keep this file out of VCS.
# Fill in secrets locally. Example values are shown; remove or replace as needed.

# Required
LLM_PROVIDER=

# API keys (leave empty until configured)
OPENAI_API_KEY=
GROQ_API_KEY=

# Model and thresholds
WHISPER_MODEL_SIZE=small
CONFIDENCE_THRESHOLD=0.75
LOW_CONFIDENCE_HALT_RATIO=0.5

# Database
DB_PATH=data/agent.db
DB_ENCRYPTION_KEY=

# Networking / retries
MAX_RETRIES_PER_NODE=3
LLM_TIMEOUT_SECONDS=60

HF_TOKEN=
LANGCHAIN_TRACING_V2=true
LANGSMITH_API_KEY=
LANGSMITH_TRACE_ID=
LANGSMITH_URL=
